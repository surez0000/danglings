{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Danglings",
  "version": "1.0.0",
  "identifier": "com.danglings.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Danglings",
        "devtools": false,
        "width": 800,
        "height": 600,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "shadow": false,
        "center": false,
        "focus": false,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "compression": "zlib"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "shortDescription": "Tiny lucky charms and companions that dangle from the top of your screen.",
    "longDescription": "A transparent, always-on-top desk companion: a lucky charm or a 3D creature on a swing that watches your cursor, plus gentle desk-time reminders to drink water, move, and rest your eyes.",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFNjZDMkVDNkJGMkI3RUMKUldUc3QvSnI3TUptSHJYVTc5dTVkaVp1MFhFRm9hUzNFOUFISEdRTW4vdjNHOEQwUDdqbFEwYWIK",
      "endpoints": [
        "https://github.com/surez0000/danglings/releases/latest/download/latest.json"
      ]
    }
  }
}
